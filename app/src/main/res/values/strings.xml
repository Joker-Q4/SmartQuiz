    <!-- 使用教程引导 -->
    <string name="guide_title">使用教程</string>
    <string name="guide_subtitle">跟着下面 5 步，快速上手</string>
    <string name="guide_step1_title">授予权限</string>
    <string name="guide_step1_desc">授予「悬浮窗」「通知」权限，并在系统设置开启无障碍服务「❤ 答题助手」</string>
    <string name="guide_step2_title">导入题库</string>
    <string name="guide_step2_desc">点「选择文件」导入 xls / xlsx / csv 题库，第一行为表头，列依次为：题目、答案、选项A~F</string>
    <string name="guide_step3_title">选择题库</string>
    <string name="guide_step3_desc">点「自动扫描」，勾选本次要匹配的题库（默认全选），匹配更准更快</string>
    <string name="guide_step4_title">开始答题</string>
    <string name="guide_step4_desc">打开目标答题页，悬浮窗实时显示匹配到的题目与参考答案，可拖动、缩放、隐藏</string>
    <string name="guide_step5_title">管理题库</string>
    <string name="guide_step5_desc">「题库管理」可查看题目详情，重命名、删除题库或删除单题</string>
    <string name="guide_confirm">开始使用</string>

